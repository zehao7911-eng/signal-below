<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#09151d">
<meta name="description" content="Send a pulse into the dark. Recover the lost beacons and return to the lift.">
<title>Signal Below · Echo Rescue</title>
<link rel="icon" href="./assets/icon.svg">
<link rel="stylesheet" href="./style.css">
</head>
<body>
<main id="app">
  <header class="top">
    <div class="identity">
      <svg viewBox="0 0 36 36" aria-hidden="true"><rect x="1" y="1" width="34" height="34" rx="9"/><path d="M8 24a13 13 0 0 1 20 0M11 20a9 9 0 0 1 14 0M15 16a4 4 0 0 1 6 0"/><circle cx="18" cy="25" r="2"/></svg>
      <div><div class="wordmark">SIGNAL BELOW</div><small>SUBSURFACE RESCUE DIVISION</small></div>
    </div>
    <button class="icon" id="sound" aria-label="Mute sound" title="Sound">♪</button>
    <button class="icon" id="menu" aria-label="Sector map" title="Sector map">▦</button>
  </header>
  <section class="heading">
    <div><div class="eyebrow" id="designation">01 / PUMP ANNEX</div><h1 id="sector">First Contact</h1></div>
    <button id="help" class="help">Field guide <b>?</b></button>
  </section>
  <div class="workspace">
    <div class="board">
      <div class="boardline"><span><i></i> ECHO IMAGING</span><span id="pos">LIFT / ONLINE</span></div>
      <canvas id="view" aria-label="Rescue map. Swipe or use the movement controls."></canvas>
      <div class="boardline bottom"><span>DEPTH <b id="depth">040 M</b></span><span>SECTOR <b id="num">01</b></span></div>
    </div>
    <aside class="console">
      <div class="metrics">
        <div><small>BEACONS</small><strong id="beacons">0 / 2</strong></div>
        <div><small>PULSE TARGET</small><strong id="scans">0 / 5</strong></div>
        <div><small>BEST</small><strong id="best">···</strong></div>
      </div>
      <div class="message" role="status"><span class="lamp"></span><span id="message">Pulse to map the passage.</span></div>
      <div class="controls">
        <div class="dpad" aria-label="Movement">
          <button class="up" data-move="0" aria-label="Move up">↑</button>
          <button class="left" data-move="3" aria-label="Move left">←</button>
          <button class="down" data-move="2" aria-label="Move down">↓</button>
          <button class="right" data-move="1" aria-label="Move right">→</button>
        </div>
        <button id="pulse" class="pulse"><span class="pulsemark">◉</span><span>PULSE<small>SPACE</small></span></button>
      </div>
      <div class="footer"><span>SWIPE · TAP A NEIGHBOR · ARROWS</span><button id="restart">Restart</button></div>
      <div class="signal-strip" aria-hidden="true">
        <span>RETURN CARRIER</span>
        <svg viewBox="0 0 230 34" preserveAspectRatio="none"><path class="baseline" d="M0 17H230"/><path class="trace" d="M0 17H20l6-4 5 9 5-15 7 21 7-17 5 6h30l5-3 4 6 4-11 4 14 6-6h25l5-3 3 5 4-8 4 12 5-6h39l4-4 4 8 5-4h10"/></svg>
        <span id="carrier">LISTENING</span>
      </div>
      <div id="extras" hidden></div>
    </aside>
  </div>
</main>
<dialog id="panel"><div class="sheet" id="sheet"></div></dialog>
<script type="module" src="./game.mjs"></script>
</body>
</html>
